NODE_ENV=local-production
HOST=0.0.0.0
PORT=3001

# Genera estos valores con los comandos documentados. No escribas contraseñas en texto plano.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12
LOCAL_API_KEY=

# Orígenes adicionales para el panel durante desarrollo, separados por coma.
# El panel compilado funciona como same-origin sin añadir su propia URL.
ALLOWED_ADMIN_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Rutas relativas a esta carpeta del servidor.
DATABASE_PATH=./data/extincheck-local.sqlite
EXTINGUISHERS_TEMPLATE_PATH=./templates/FORMATOS P.R. CANCUN.xlsx
GENERATED_REPORTS_PATH=./generated-reports
ADMIN_WEB_PATH=./admin-web/dist

# Límites opcionales.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
MOBILE_SYNC_RATE_LIMIT_WINDOW_MS=60000
MOBILE_SYNC_RATE_LIMIT_MAX=120
EVIDENCE_RATE_LIMIT_WINDOW_MS=60000
EVIDENCE_RATE_LIMIT_MAX=300
DOWNLOAD_RATE_LIMIT_WINDOW_MS=60000
DOWNLOAD_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=600
