{
  "name": "extincheck-local-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build:admin && npm run build:server",
    "build:admin": "npm --prefix admin-web run build",
    "build:server": "tsc -p tsconfig.json",
    "install:admin": "npm --prefix admin-web install",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "inspect": "tsx src/inspect.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "exceljs": "^4.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
